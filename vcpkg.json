{
  "name": "mukki-reborn-engine",
  "version-string": "0.1.0",
  "description": "Vendor-agnostic game engine with a Vulkan RHI and a deferred renderer",
  "builtin-baseline": "1f5e0348089e8a9b187f57d42866ebc871e815da",
  "overrides": [
    {
      "name": "tinygltf",
      "version": "2.9.3"
    }
  ],
  "features": {
    "tracy": {
      "description": "Tracy profiler instrumentation (on-demand)",
      "dependencies": [
        {
          "name": "tracy",
          "default-features": false,
          "features": [
            "on-demand"
          ]
        }
      ]
    }
  },
  "dependencies": [
    {
      "name": "box3d",
      "version>=": "0.1.0"
    },
    "glfw3",
    "glm",
    "gtest",
    "nlohmann-json",
    "spirv-reflect",
    "tinygltf",
    "vulkan",
    "vulkan-memory-allocator",
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "glfw-binding",
        "vulkan-binding"
      ]
    }
  ]
}
