{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "inherits": "windows-base"
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "inherits": "windows-base"
    },
    {
      "name": "windows-debug-tracy",
      "displayName": "Windows Debug (Tracy)",
      "inherits": "windows-base",
      "cacheVariables": {
        "MRE_ENABLE_TRACY": "ON",
        "VCPKG_MANIFEST_FEATURES": "tracy"
      }
    },
    {
      "name": "windows-release-tracy",
      "displayName": "Windows Release (Tracy)",
      "inherits": "windows-base",
      "cacheVariables": {
        "MRE_ENABLE_TRACY": "ON",
        "VCPKG_MANIFEST_FEATURES": "tracy"
      }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-linux"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux Debug",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-debug-tracy",
      "displayName": "Linux Debug (Tracy)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MRE_ENABLE_TRACY": "ON",
        "VCPKG_MANIFEST_FEATURES": "tracy"
      }
    },
    {
      "name": "linux-release-tracy",
      "displayName": "Linux Release (Tracy)",
      "inherits": "linux-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MRE_ENABLE_TRACY": "ON",
        "VCPKG_MANIFEST_FEATURES": "tracy"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release"
    },
    {
      "name": "windows-debug-tracy",
      "configurePreset": "windows-debug-tracy",
      "configuration": "Debug"
    },
    {
      "name": "windows-release-tracy",
      "configurePreset": "windows-release-tracy",
      "configuration": "Release"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-debug-tracy",
      "configurePreset": "linux-debug-tracy"
    },
    {
      "name": "linux-release-tracy",
      "configurePreset": "linux-release-tracy"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release",
      "configurePreset": "windows-release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-debug-tracy",
      "configurePreset": "windows-debug-tracy",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-release-tracy",
      "configurePreset": "windows-release-tracy",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug-tracy",
      "configurePreset": "linux-debug-tracy",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release-tracy",
      "configurePreset": "linux-release-tracy",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
